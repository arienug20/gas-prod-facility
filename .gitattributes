# Normalisasi akhir baris agar konsisten lintas OS.
# Penting untuk CI Linux: YAML/skrip dengan CRLF bisa gagal dieksekusi.
* text=auto eol=lf

*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Skrip Windows boleh CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Biner CAD: jangan pernah diubah
*.dxf   binary
*.dwg   binary
*.png   binary
*.step  binary
*.pdf   binary
*.zip   binary
